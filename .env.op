# OurTube environment - processed by op inject
# Run: task envs:op

# Discord webhook for the "default" group.
# Webhooks are resolved by convention: a video in group <G> fires every env var
# named OT_WEBHOOK_URL_<G> and OT_WEBHOOK_URL_<G>_* (G uppercased, non-alnum -> _).
# Add more per group, e.g. OT_WEBHOOK_URL_GAMING, OT_WEBHOOK_URL_GAMING_2, ...
OT_WEBHOOK_URL_DEFAULT="op://Private/ourtube/discord_webhook_url"

# Retention: purge videos whose publishedAt is older than this many days.
# Watch Later videos are always kept. Unset / 0 / negative = disabled
# (keep everything forever). Swept on boot and after each poll tick.
# OT_RETENTION_DAYS="90"
